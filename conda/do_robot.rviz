Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LaserScan1
        - /Map1
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time

Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane Cell Count: 30
      Cell Size: 1
      Color: 80; 80; 90
      Alpha: 0.4

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Frame Timeout: 15

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.45

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.55

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 80; 255; 80
      Decay Time: 0

    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 50; 130; 255
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 70; 70
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 60; 220; 220

    - Class: rviz_default_plugins/Polygon
      Name: Collision Approach
      Enabled: true
      Topic:
        Value: /collision_approach
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 30; 0

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Alpha: 1
        Shaft Length: 0.3
        Shaft Radius: 0.04
        Head Length: 0.1
        Head Radius: 0.08
      Covariance:
        Value: false

    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Normalize Range: true

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
        Durability Policy: Volatile
        Reliability Policy: Reliable

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down (map)
      Target Frame: <Fixed Frame>
      Scale: 70
      Angle: 0
      X: 0
      Y: 0
      Invert Z Axis: false
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit (3D)
        Target Frame: base_link
        Distance: 6
        Pitch: 0.6
        Yaw: 0.785
        Focal Point:
          X: 0
          Y: 0
          Z: 0

Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Time:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: false
