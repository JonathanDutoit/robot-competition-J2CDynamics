<?xml version="1.0"?>
<robot xmlns:xacro="http://wwww.ros.org/wiki/xacro">

	<link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_link_height / 2.0 + base_link_ground_clearance}"  rpy="0 0 0"/>
            <geometry>
                <box size="${base_link_length} ${base_link_width} ${base_link_height}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_link_height / 2.0 + base_link_ground_clearance}"  rpy="0 0 0"/>
            <geometry>
                <box size="${base_link_length} ${base_link_width} ${base_link_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${total_mass * 0.8 * 0.95}" l="${base_link_length}" w="${base_link_width}" h="${base_link_height}"
                       xyz="0 0 ${base_link_height / 2.0 + base_link_ground_clearance}"  rpy="0 0 0"/>
    </link>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            <geometry>
                <cylinder length="${wheels_length}" radius="${wheels_radius}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            <geometry>
                <cylinder length="${wheels_length}" radius="${wheels_radius}"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="${total_mass * 0.2 * 0.5}" r="${wheels_radius}" h="${wheels_length}"
                            xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
    </link>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            <geometry>
                <cylinder length="${wheels_length}" radius="${wheels_radius}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            <geometry>
                <cylinder length="${wheels_length}" radius="${wheels_radius}"/>
            </geometry> 
        </collision>
        <xacro:cylinder_inertia m="${total_mass * 0.2 * 0.5}" r="${wheels_radius}" h="${wheels_length}"
                            xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
    </link>

    <link name="ball_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${ball_wheel_radius}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${ball_wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:sphere_inertia m="${total_mass * 0.8 * 0.05}" r="${ball_wheel_radius}" xyz="0 0 0" rpy="0 0 0"/>
    </link>

    <joint name="right_wheel_joint" type="continuous">
	    <parent link="base_link"/>
	    <child link="right_wheel"/>
	    <origin xyz="-${wheels_x_offset} -${wheels_spacing / 2.0} ${wheels_radius}" rpy="0 0 0"/>
	    <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.2"/>
	</joint>

	<joint name="left_wheel_joint" type="continuous">
	    <parent link="base_link"/>
	    <child link="left_wheel"/>
	    <origin xyz="-${wheels_x_offset} ${wheels_spacing / 2.0} ${wheels_radius}" rpy="0 0 0"/>
	    <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.2"/>
	</joint>

	<joint name="ball_wheel_joint" type="fixed">
	    <parent link="base_link"/>
	    <child link="ball_wheel"/>
	    <origin xyz="${ball_wheel_x_offset} 0 ${ball_wheel_radius}" rpy="0 0 0"/>
	</joint>

</robot>