<?xml version="1.0"?>
<robot name="do" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_sim" default="false"/>
    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find j2cdynamics_bringup)/config/do_diff_drive_controller.yaml</parameters>
             <ros>
                <!-- <remapping>/diff_drive_controller/cmd_vel:=/cmd_vel</remapping> -->
                <remapping>/diff_drive_controller/odom:=/odom</remapping>
                <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
            </ros>
        </plugin>
    </gazebo>
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
        <!-- SIMULATION: gazebo_ros2_control handles joints directly -->
        <xacro:if value="$(arg use_sim)">
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>

        <!-- REAL ROBOT: Arduino serial interface -->
        <xacro:unless value="$(arg use_sim)">
            <plugin>j2cdynamics_driver/ArduinoHardwareInterface</plugin>
            <param name="port">/dev/arduino</param>
            <param name="baudrate">115200</param>
            <param name="max_rad_s">7.0</param>
            <param name="ramp_step">0.5</param>
        </xacro:unless>
        </hardware>

        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-7.0</param>    
                <param name="max">7.0</param>
            </command_interface>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-7.0</param>
                <param name="max">7.0</param>
            </command_interface>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
</robot>