<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>j2cdynamics_driver</name>
  <version>0.1.0</version>
  <description>
    Arduino serial hardware interface for the j2cdynamics robot.
    Implements a ros2_control SystemInterface plugin that communicates
    with the Arduino over serial using the SPEED/ODOMETRY protocol.
  </description>

  <maintainer email="dutoit.jonathaneric@gmail.com">Dutoit Jonathan</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ros2_control dependencies -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/common_hardware_interface.xml"/>
  </export>
</package>